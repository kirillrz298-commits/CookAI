@echo off
chcp 65001 > nul
title Запуск CookBook AI
echo ===================================================
echo           Запуск приложения CookBook AI
echo ===================================================
echo.

:: Проверка наличия Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [ОШИБКА] Node.js не установлен!
    echo Для работы CookBook AI требуется среда выполнения Node.js.
    echo Пожалуйста, скачайте и установите её с официального сайта: https://nodejs.org/
    echo После установки перезапустите этот файл.
    echo.
    pause
    exit /b
)

:: Проверка папки node_modules
if not exist node_modules (
    echo [ИНФО] Папка node_modules не найдена. Устанавливаем зависимости...
    echo Это может занять некоторое время...
    call npm install
    if %errorlevel% neq 0 (
        echo [ОШИБКА] Не удалось установить зависимости. Проверьте подключение к интернету.
        pause
        exit /b
    )
)

echo [ИНФО] Запуск серверов (интерфейс и база данных)...
echo Браузер должен открыться автоматически по адресу http://localhost:5173
echo (Если этого не произошло, откройте ссылку вручную)
echo.
echo Для остановки приложения просто закройте это окно командной строки.
echo ===================================================
echo.

:: Запускаем браузер с небольшой задержкой, чтобы сервер успел запуститься
start "" http://localhost:5173

:: Запуск веб-приложения
call npm run dev
pause
